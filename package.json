{
  "name": "flowrunner",
  "version": "0.0.0",
  "private": true,
  "description": "Runner local y desatendido que lleva una feature hasta una PR, con un cerebro por repo que aprende.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "smoke": "vitest run --project smoke",
    "verify": "pnpm lint && pnpm test && pnpm test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "flowrunner": "./bin/flowrunner.js"
  }
}
